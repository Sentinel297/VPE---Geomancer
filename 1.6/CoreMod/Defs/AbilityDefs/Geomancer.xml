<VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase" MayRequire="Ludeon.Rimworld.Odyssey">
	<defName>VPE_SandstormSTNL</defName>
	<label>Sandstorm</label>
	<description>Warp a distant sandstorm towards your location, it will reduce accuracy and slow down anyone not under a roof.</description>
	<iconPath>UI_GeomancerSTNL/Abilities/Sandstorm</iconPath>
	<abilityClass>SentinelFramework_STNL.Ability_ForceCondition</abilityClass>
	<castTime>180</castTime>
	<durationTime>60000</durationTime>
	<!-- <chance>0</chance> -->
	<targetMode>Self</targetMode>
	<castSound>Psycast_Neuroquake_Effect</castSound>
	<needsTicking>true</needsTicking>
	<showUndrafted>true</showUndrafted>
	<modExtensions>
		<li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
			<path>VPE_GeomancerSTNL</path>
			<level>4</level>
			<order>1</order>
			<psyfocusCost>0.20</psyfocusCost>
			<entropyGain>60</entropyGain>
			<prerequisites>
				<li>VPE_QuakeSTNL</li>
			</prerequisites>
		</li>
		<li Class="SentinelFramework_STNL.AbilityForceCondiExt">
			<conditionDef>SandstormSTNL</conditionDef>
			<global>false</global>
			<scaleDuraWithSensi>True</scaleDuraWithSensi>
			<aiCanUse>true</aiCanUse>
		</li>
	</modExtensions>
</VEF.Abilities.AbilityDef>

