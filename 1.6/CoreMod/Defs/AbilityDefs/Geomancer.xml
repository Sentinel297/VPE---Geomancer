	<iconPath>UI_GeomancerSTNL/Abilities/KidneyStone</iconPath>
	<abilityClass>VPE_Geomancer.Ability_KidneyStone</abilityClass>
	<castTime>30</castTime>
	<range>14.9</range>
	<radius>0</radius>
	<chance>0</chance>
	<targetMode>Pawn</targetMode>
	<targetingParameters>
		<canTargetLocations>false</canTargetLocations>
		<canTargetSelf>true</canTargetSelf>
		<canTargetAnimals>true</canTargetAnimals>
		<canTargetPawns>true</canTargetPawns>
		<canTargetHumans>true</canTargetHumans>
		<canTargetItems>false</canTargetItems>
		<canTargetMechs>true</canTargetMechs>
	</targetingParameters>
	<needsTicking>true</needsTicking>
	<castSound>PsycastPsychicEffect</castSound>
	<modExtensions>
		<li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
			<path>VPE_GeomancerSTNL</path>
			<level>1</level>
			<order>2</order>
			<psyfocusCost>0.10</psyfocusCost>
			<entropyGain>15</entropyGain>
		</li>
	</modExtensions>
</VEF.Abilities.AbilityDef>

<!-- Level 2 -->

<VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
	<defName>VPE_ChunkBurstSTNL</defName>
	<label>Chunk Burst</label>
	<description>Psychically destabilize the minerals present within the target chunk, causing it to detonate.\nDamage scales with psychic sensitivity (100% sensitivity = 10 damage)</description>
	<iconPath>UI_GeomancerSTNL/Abilities/Burst</iconPath>
	<abilityClass>VPE_Geomancer.Ability_ChunkBurst</abilityClass>
	<castTime>30</castTime>
	<range>20.9</range>
	<radius>2</radius>
	<chance>0</chance>
	<targetMode>Location</targetMode>
	<targetingParameters>
		<canTargetLocations>true</canTargetLocations>
		<canTargetSelf>false</canTargetSelf>
		<canTargetAnimals>false</canTargetAnimals>
		<canTargetPawns>false</canTargetPawns>
		<canTargetHumans>false</canTargetHumans>
		<canTargetItems>true</canTargetItems>
		<canTargetMechs>false</canTargetMechs>
	</targetingParameters>
	<needsTicking>true</needsTicking>
	<castSound>PsycastPsychicEffect</castSound>
	<modExtensions>
		<li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
			<path>VPE_GeomancerSTNL</path>
			<level>2</level>
			<order>2</order>
			<psyfocusCost>0.06</psyfocusCost>
			<entropyGain>10</entropyGain>
			<prerequisites>
			<li>VPE_KidneyStoneSTNL</li>
			<li>VPE_ChunkSkipSTNL</li>
			</prerequisites>
		</li>
	</modExtensions>
</VEF.Abilities.AbilityDef>

