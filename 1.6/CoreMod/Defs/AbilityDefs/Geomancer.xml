<Defs>	

  <!-- Level 1 -->


<VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
	<defName>VPE_ChunkSkipSTNL</defName>
	<label>Chunk Manifestation</label>
	<description>Skip a chunk made out of random rocks from within the planet to the target location.</description>
	<iconPath>UI_GeomancerSTNL/Abilities/Chunk</iconPath>
	<abilityClass>VPE_Geomancer.Ability_ChunkManifestation</abilityClass>
	<castTime>20</castTime>
	<range>14.9</range>
	<radius>0</radius>
	<chance>0</chance>
	<targetMode>Pawn</targetMode>
	<targetingParameters>
		<canTargetLocations>true</canTargetLocations>
		<canTargetSelf>false</canTargetSelf>
		<canTargetAnimals>false</canTargetAnimals>
		<canTargetPawns>false</canTargetPawns>
		<canTargetHumans>false</canTargetHumans>
		<canTargetItems>false</canTargetItems>
		<canTargetMechs>false</canTargetMechs>
	</targetingParameters>
	<needsTicking>true</needsTicking>
	<castSound>PsycastPsychicEffect</castSound>
	<modExtensions>
		<li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
			<path>VPE_GeomancerSTNL</path>
			<level>1</level>
			<order>1</order>
			<psyfocusCost>0.03</psyfocusCost>
			<entropyGain>5</entropyGain>
		</li>
	</modExtensions>
</VEF.Abilities.AbilityDef>

<VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
